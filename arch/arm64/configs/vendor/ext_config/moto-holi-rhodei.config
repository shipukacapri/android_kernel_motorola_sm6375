#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
# After building, a list of all of the config files that are used can be found
# at the top of:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/mapphone_defconfig
#
# The actual output of the kernel configuration system can be found at:
# out/target/product/$(PRODUCT)/obj/KERNEL_OBJ/.config
#
# You can check the .config file to verify that your configuration option is
# being set as expected.
#
CONFIG_RHODEI_DTB=y

# Audio
CONFIG_AW882XX_STEREO_SMARTPA=y
CONFIG_AW882XX_PARAMS_FROM_BIN=y
CONFIG_AW882XX_MAPSIZE_16K=y

# Backlight                                                                                                     
CONFIG_LEDS_AW99703=m                                                                                           

# Camera
CONFIG_AF_NOISE_ELIMINATION=y
CONFIG_CAM_SENSOR_PROBE_RETRY=y
CONFIG_CAMERA_CCI_INTF=m

# Charger
CONFIG_REGULATOR_WL2868C=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_TCPC_CLASS=m
CONFIG_TCPC_SGM7220=m
CONFIG_TCPC_RT1711H=m
CONFIG_TYPEC_ADAPTER_CLASS=m
CONFIG_MMI_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER=m
CONFIG_MMI_DISCRETE_CHARGER_CLASS=m
CONFIG_MMI_DISCRETE_TURBO_CHARGER=m
CONFIG_MMI_SM5602_FG=m
CONFIG_USB_POWER_DELIVERY=y
CONFIG_RT_PD_MANAGER=m
CONFIG_SGM4154X_CHARGER=m
CONFIG_BQ2589X_CHARGER=m
CONFIG_BQ2597X_MMI_IIO=m
CONFIG_CW2217B_FG_MMI=m
CONFIG_MMI_QC3P_TURBO_CHARGER=y

# Charger
CONFIG_USE_MMI_CHARGER=y

# Display
# CONFIG_REGULATOR_QPNP_LCDB is not set

# Fingerprint
CONFIG_INPUT_EGIS_FPS_MMI=m
CONFIG_INPUT_FOCAL_FPS_MMI=m

# MMI
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MMI_RELAY=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_MOTO_UTAGS=m
CONFIG_SENSORS_CLASS=m

# NFC
CONFIG_NFC=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC=m
CONFIG_SEC_NFC_IF_I2C=y

# Pinctrl
CONFIG_QUP0_SE2_AP=y

# SAR
CONFIG_SARSENSOR_SX937X=m

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_MMI=m
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_NOTIFY_TOUCH_STATE=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_LAST_TIME=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_PANEL_NOTIFICATIONS=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_DRM_PANEL=y
CONFIG_TOUCHSCREEN_NOVA_0FLASH_MMI_WAKEUP_GESTURE_CTRL=y
CONFIG_INPUT_TOUCHSCREEN_MMI=m
CONFIG_DRM_PANEL_NOTIFICATIONS=y
CONFIG_BOARD_USES_DOUBLE_TAP_CTRL=y

# UFS
# CONFIG_MICRON_UFSHID is not set
# CONFIG_UFSTW is not set

# Vibrator
CONFIG_LDO_VIBRATOR_MMI=m

# Erofs
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y
